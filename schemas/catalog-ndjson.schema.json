{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ictechgy/schemagraph/blob/main/schemas/catalog-ndjson.schema.json",
  "$comment": "Validate each non-empty NDJSON line against this schema. The codec, rather than JSON Schema, enforces line order, one header, schema ownership, the v2 final limitations trailer, chronological trailer placement, feature use across records (including external-queries-v1 for query routines), the v1 query-routine prohibition, and trailer-context identity. The limitations trailer may carry a finalized context object; its source/database/schema_filter identity must match the header while catalog_complete may be finalized there. Unknown optional fields remain allowed and are reported as limitations.",
  "oneOf": [
    {"$ref": "#/$defs/document_v1"},
    {"$ref": "#/$defs/document_v2"},
    {"$ref": "#/$defs/schema_record"},
    {"$ref": "#/$defs/object_record"},
    {"$ref": "#/$defs/routine_record"},
    {"$ref": "#/$defs/dependency_record"},
    {"$ref": "#/$defs/limitations_record"}
  ],
  "$defs": {
    "document_v1": {
      "type": "object",
      "required": ["type", "version", "dialect", "reader", "limitations"],
      "properties": {
        "type": {"const": "document"},
        "version": {"const": 1},
        "dialect": {"type": "string"},
        "reader": {"type": "string"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "context": {"anyOf": [{"$ref": "#/$defs/context"}, {"type": "null"}]}
      },
      "not": {
        "anyOf": [
          {"required": ["producer"]},
          {"required": ["required_features"]},
          {"required": ["schemas"]},
          {"required": ["dependencies"]}
        ]
      },
      "additionalProperties": true
    },
    "document_v2": {
      "type": "object",
      "required": ["type", "version", "dialect", "producer", "required_features", "limitations"],
      "properties": {
        "type": {"const": "document"},
        "version": {"const": 2},
        "dialect": {"type": "string"},
        "producer": {
          "type": "object",
          "required": ["name"],
          "properties": {"name": {"type": "string", "minLength": 1}},
          "additionalProperties": true
        },
        "required_features": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["catalog-dependencies-v1", "external-queries-v1", "package-members-v1", "usage-v1"]
          }
        },
        "limitations": {"type": "array", "items": {"type": "string"}},
        "context": {"anyOf": [{"$ref": "#/$defs/context"}, {"type": "null"}]}
      },
      "not": {
        "anyOf": [
          {"required": ["reader"]},
          {"required": ["schemas"]},
          {"required": ["dependencies"]}
        ]
      },
      "additionalProperties": true
    },
    "schema_record": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {"type": {"const": "schema"}, "name": {"type": "string"}},
      "additionalProperties": true
    },
    "object_record": {
      "type": "object",
      "required": ["type", "schema", "data"],
      "properties": {
        "type": {"const": "object"},
        "schema": {"type": "string"},
        "data": {"$ref": "#/$defs/object"}
      },
      "additionalProperties": true
    },
    "routine_record": {
      "type": "object",
      "required": ["type", "schema", "data"],
      "properties": {
        "type": {"const": "routine"},
        "schema": {"type": "string"},
        "data": {"$ref": "#/$defs/routine"}
      },
      "additionalProperties": true
    },
    "dependency_record": {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {"const": "dependency"},
        "data": {"$ref": "#/$defs/dependency"}
      },
      "additionalProperties": true
    },
    "limitations_record": {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {"const": "limitations"},
        "data": {"type": "array", "items": {"type": "string"}},
        "context": {"$ref": "#/$defs/context"}
      },
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "required": ["source_id", "catalog_complete"],
      "properties": {
        "source_id": {"type": "string"},
        "database": {"type": ["string", "null"]},
        "schema_filter": {"type": ["array", "null"], "items": {"type": "string"}},
        "catalog_complete": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "object_ref": {
      "type": "object",
      "required": ["schema", "name"],
      "properties": {
        "schema": {"type": "string"},
        "name": {"type": "string"},
        "kind": {"type": ["string", "null"]},
        "member": {"type": ["string", "null"]},
        "signature": {"type": ["string", "null"]},
        "database": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "dependency": {
      "type": "object",
      "required": ["source", "target", "catalog", "dependency_type"],
      "properties": {
        "source": {"$ref": "#/$defs/object_ref"},
        "target": {"$ref": "#/$defs/object_ref"},
        "catalog": {"type": "string"},
        "dependency_type": {"type": "string"}
      },
      "additionalProperties": true
    },
    "schema": {
      "type": "object",
      "required": ["name", "objects", "routines"],
      "properties": {
        "name": {"type": "string"},
        "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "routines": {"type": "array", "items": {"$ref": "#/$defs/routine"}}
      },
      "additionalProperties": true
    },
    "object": {
      "type": "object",
      "required": ["name", "kind", "columns", "constraints", "indexes", "triggers"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"type": "string"},
        "columns": {"type": "array", "items": {"$ref": "#/$defs/column"}},
        "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
        "indexes": {"type": "array", "items": {"$ref": "#/$defs/index"}},
        "triggers": {"type": "array", "items": {"$ref": "#/$defs/trigger"}},
        "body": {"type": ["string", "null"]},
        "usage": {"anyOf": [{"$ref": "#/$defs/usage"}, {"type": "null"}]}
      },
      "additionalProperties": true
    },
    "column": {
      "type": "object",
      "required": ["name", "data_type", "nullable", "ordinal", "pk_position"],
      "properties": {
        "name": {"type": "string"},
        "data_type": {"type": "string"},
        "nullable": {"type": "boolean"},
        "default": {"type": ["string", "null"]},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "pk_position": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      },
      "additionalProperties": true
    },
    "constraint": {
      "type": "object",
      "required": ["name", "kind", "columns"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"type": "string"},
        "columns": {"type": "array", "items": {"type": "string"}},
        "referenced": {"anyOf": [{"$ref": "#/$defs/referenced"}, {"type": "null"}]}
      },
      "additionalProperties": true
    },
    "referenced": {
      "type": "object",
      "required": ["table", "columns"],
      "properties": {
        "schema": {"type": ["string", "null"]},
        "table": {"type": "string"},
        "columns": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "index": {
      "type": "object",
      "required": ["name", "unique", "columns"],
      "properties": {
        "name": {"type": "string"},
        "unique": {"type": "boolean"},
        "columns": {"type": "array", "items": {"type": "string"}},
        "usage": {"anyOf": [{"$ref": "#/$defs/usage"}, {"type": "null"}]},
        "definition_complete": {"type": ["boolean", "null"]},
        "predicate": {"type": ["string", "null"]},
        "has_predicate": {"type": ["boolean", "null"]}
      },
      "additionalProperties": true
    },
    "trigger": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string"}, "body": {"type": ["string", "null"]}},
      "additionalProperties": true
    },
    "routine": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"type": "string"},
        "language": {"type": ["string", "null"]},
        "body": {"type": ["string", "null"]},
        "signature": {"type": ["string", "null"]},
        "usage": {"anyOf": [{"$ref": "#/$defs/usage"}, {"type": "null"}]},
        "member_of": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "required": ["reads", "writes"],
      "properties": {
        "since": {"type": ["string", "null"]},
        "reads": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "writes": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "scans": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "total_ms": {"type": ["number", "null"]},
        "self_ms": {"type": ["number", "null"]}
      },
      "additionalProperties": true
    }
  }
}
